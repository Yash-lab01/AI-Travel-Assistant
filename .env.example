# ─── LLM APIs ─────────────────────────────────────────────────────────────────
# Primary reasoning + tool-calling (free tier, ~1,500 RPD)
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_key_here

# Speed fallback + slot-filling (free tier, Llama 3.3 70B ~1,000 RPD, Llama 3.1 8B ~14,400 RPD)
GROQ_API_KEY=your_groq_api_key_here

# ─── Search & Data ────────────────────────────────────────────────────────────
# LLM-oriented search results (niche signal fallback T2)
TAVILY_API_KEY=your_tavily_api_key_here

# Tourism-specific POI data (primary, free, cacheable)
OPENTRIPMAP_API_KEY=your_opentripmap_api_key_here

# Photos, hours, ratings enrichment (enrichment-only, minimal calls)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ─── Reddit (PRAW — niche signal T1) ─────────────────────────────────────────
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=ai-travel-assistant/0.1 (by /u/your_username)

# ─── Map ──────────────────────────────────────────────────────────────────────
# Interactive map (generous free tier)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# ─── Observability ────────────────────────────────────────────────────────────
# LangSmith tracing — set to true to see agent graph traces in real-time
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=ai-travel-assistant

# ─── Local narration model (Ollama) ──────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
NARRATION_MODEL=travel-narrator-lora  # Name of your fine-tuned model in Ollama

# ─── App ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
