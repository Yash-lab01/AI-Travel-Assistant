# WanderAI Travel Narrator Modelfile — Phase 5
# Serves fine-tuned Llama 3.2 3B atmospheric travel narration model via Ollama
#
# To build and run with Ollama:
# 1. ollama create travel-narrator -f ./ml/Modelfile
# 2. ollama run travel-narrator

FROM llama3.2:3b

# Set model parameters for concise, atmospheric storytelling
PARAMETER temperature 0.4
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER repeat_penalty 1.15
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|end_of_text|>"

SYSTEM """You are an expert travel writer specializing in evocative, atmospheric, and sensory travel narrations for day-by-day itineraries.
Your writing is:
1. Concise: Exactly 1 to 2 evocative sentences (under 30 words total).
2. Sensory & Vivid: Captures light, aromas, sounds, architectural textures, and authentic local atmosphere.
3. Cliché-Free: Never use generic phrases like "a must-see attraction", "rich history and culture", "popular tourist destination", or "a great place to visit".
4. Present Tense: Immerses the traveler directly in the moment."""

TEMPLATE """<|begin_of_text|><|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|><|start_header_id|>user<|end_header_id|>

{{ .Prompt }}<|eot_id|><|start_header_id|>assistant<|end_header_id|>

{{ .Response }}<|eot_id|>"""
